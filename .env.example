# ═══════════════════════════════════════════════════════════════════════════════
# PayRecover AI — Environment Variables
# Copy to .env and fill in actual values. Never commit .env.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Spring Profile ──────────────────────────────────────────────────────────────
# dev     = H2 in-memory DB, localhost services, debug logging
# prod    = MySQL, environment variables, production logging
SPRING_PROFILES_ACTIVE=dev

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database (prod only — ignored when using dev profile) ──────────────────────
DB_URL=jdbc:mysql://mysql:3306/payrecover?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=payrecover
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
JPA_PLATFORM=org.hibernate.dialect.MySQL8Dialect
JPA_DDL=update

# ── FastAPI AI Service ─────────────────────────────────────────────────────────
# Use "http://fastapi:8001" inside Docker, "http://127.0.0.1:8001" for local dev
AI_SERVICE_URL=http://fastapi:8001

# ── Demo Reset (dev only) ──────────────────────────────────────────────────────
# Set to "true" to enable POST /api/demo/reset endpoint
DEMO_RESET_ENABLED=false

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SHOW_SQL=false
THYMELEAF_CACHE=true
H2_CONSOLE=false
